{
  "name": "formsaathi",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@12.22.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev:extension": "pnpm --filter @formsaathi/extension dev",
    "build:extension": "pnpm --filter @formsaathi/extension build",
    "dev:server": "pnpm --filter @formsaathi/server dev",
    "start:server": "pnpm --filter @formsaathi/server start",
    "check:server": "node --check server/src/index.js && node --check server/src/ocr.js && node --check server/src/facts.js && node --check server/src/prepare.js",
    "test": "node --test server/test/facts.test.js",
    "dev:web": "pnpm --filter @formsaathi/web dev",
    "build:web": "pnpm --filter @formsaathi/web build",
    "check:web": "pnpm --filter @formsaathi/web typecheck",
    "build": "pnpm build:web && pnpm build:extension",
    "dev:rapidocr": "python -m uvicorn rapidocr_service.main:app --host 127.0.0.1 --port 8788"
  }
}
