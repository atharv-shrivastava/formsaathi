{
  "name": "formsaathi",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["extension", "server"],
  "scripts": {
    "dev:extension": "npm run dev --workspace @formsaathi/extension",
    "build:extension": "npm run build --workspace @formsaathi/extension",
    "dev:server": "npm run dev --workspace @formsaathi/server",
    "start:server": "npm run start --workspace @formsaathi/server",
    "check:server": "node --check server/src/index.js && node --check server/src/ocr.js && node --check server/src/facts.js && node --check server/src/prepare.js",
    "test": "node --test server/test/facts.test.js"
  }
}
